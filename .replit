modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "sightread-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "sightread-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "sightread-build"

[[workflows.workflow]]
name = "sightread-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/sightread-ai run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "sightread-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/sightread-ai run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "sightread-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=18449 BASE_PATH=/ pnpm --filter @workspace/sightread-ai run build"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
